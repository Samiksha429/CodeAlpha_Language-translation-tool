rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable global validation helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. User document payload validation
    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.email is string && data.email.size() <= 128
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128));
    }

    // 4. History log payload validation
    function isValidHistoryItem(data) {
      return data.id is string && data.id.size() <= 128
        && data.sourceText is string && data.sourceText.size() <= 10000
        && data.translatedText is string && data.translatedText.size() <= 10000
        && data.sourceLang is string && data.sourceLang.size() <= 100
        && data.targetLang is string && data.targetLang.size() <= 100
        && data.timestamp is int;
    }

    // 5. Bookmarked items payload validation
    function isValidSavedItem(data) {
      return data.id is string && data.id.size() <= 128
        && data.sourceText is string && data.sourceText.size() <= 10000
        && data.translatedText is string && data.translatedText.size() <= 10000
        && data.sourceLang is string && data.sourceLang.size() <= 100
        && data.targetLang is string && data.targetLang.size() <= 100
        && data.timestamp is int;
    }

    // 6. Main nodes and sub-collections matches
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if false; // For security integrity, profiles cannot be deleted directly

      // Sub-collection to track Translation History
      match /history/{historyId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(historyId) && isValidHistoryItem(request.resource.data);
        allow update: if false; // History entries are immutable logs
        allow delete: if isOwner(userId) && isValidId(historyId);
      }

      // Sub-collection to track Starred/Saved translations
      match /saved/{savedId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(savedId) && isValidSavedItem(request.resource.data);
        allow update: if false; // Saved entries are immutable logs
        allow delete: if isOwner(userId) && isValidId(savedId);
      }
    }
  }
}
